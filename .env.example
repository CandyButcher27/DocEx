# ── OCR ────────────────────────────────────────────────────────────────────
# Engine used for value extraction. Extraction is ALWAYS OCR (never the VLM).
# Options: stub | tesseract | easyocr | trocr | paddle
#   stub      - deterministic, no deps (tests / offline demo)
#   tesseract - light, needs the Tesseract binary on PATH (pytesseract)
#   easyocr   - torch-based, good general accuracy
#   trocr     - microsoft/trocr-base-handwritten, best for handwriting, heavy
#   paddle    - PaddleOCR, needs paddlepaddle
OCR_ENGINE=stub

# ── VLM (only used when a scanned doc matches NO existing template) ──────────
# The VLM derives structure + bounding boxes for unknown docs, then a template
# is auto-generated so the next similar doc takes the cheap template path.
# Options: fake | anthropic | openai
#   fake      - deterministic, no API key (tests / offline demo)
VLM_PROVIDER=fake

# Provider API keys (only the selected provider's key is needed)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# Optional explicit model id. Leave blank to use the provider default
# (anthropic -> claude-sonnet-4-6, openai -> gpt-4o).
VLM_MODEL=

# ── Registration / routing ──────────────────────────────────────────────────
# Inlier ratio + absolute inlier count required to accept a template match.
# Below these (or template not yet annotated) -> route to the VLM fallback.
REGISTRATION_MATCH_THRESHOLD=0.18
REGISTRATION_MIN_INLIERS=12

# ── Paths ───────────────────────────────────────────────────────────────────
# Poppler bin dir for pdf2image (leave blank if pdftoppm is already on PATH).
POPPLER_PATH=
TEMPLATES_DIR=
OUTPUT_DIR=
